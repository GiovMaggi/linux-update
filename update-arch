#!/bin/bash

echo "Starting system update..."

# Steps that fail are collected here and reported at the end
FAILED=()

# Update official packages (and AUR, with yay or paru)
# Uses yay if installed, otherwise paru, otherwise plain pacman
# --noconfirm: answer every prompt with its default
# --ask 20:    flip the two defaults that would cancel the update
#              (4 = remove conflicting packages, 16 = skip packages with broken dependencies)
if command -v yay >/dev/null; then
    yay -Syu --noconfirm --ask 20 || FAILED+=("system packages (yay -Syu)")
elif command -v paru >/dev/null; then
    paru -Syu --noconfirm --ask 20 || FAILED+=("system packages (paru -Syu)")
else
    sudo pacman -Syu --noconfirm --ask 20 || FAILED+=("system packages (pacman -Syu)")
fi

# Update Flatpak applications
if command -v flatpak >/dev/null; then
    flatpak update -y || FAILED+=("Flatpak apps (flatpak update)")
fi

echo ""
echo "=========================================="
if [ ${#FAILED[@]} -eq 0 ]; then
    echo "All updates completed successfully!"
else
    echo "Some updates FAILED:"
    for step in "${FAILED[@]}"; do
        echo "  - $step"
    done
    echo "Scroll up to see the error messages."
fi
echo "=========================================="
echo ""

# Prompt for post-update action
read -p "Choose action: [r]eboot / [p]oweroff / [n]othing (default): " choice

case "$choice" in
    r|reboot)
        echo "Rebooting system..."
        systemctl reboot
        ;;
    p|poweroff)
        echo "Powering off system..."
        systemctl poweroff
        ;;
    *)
        echo "Doing nothing. Have a great day!"
        ;;
esac
