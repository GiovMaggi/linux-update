#!/bin/bash

usage() {
    echo "Usage: update [main | flatpak | <app>] [-r | -p | -n]"
    echo ""
    echo "What to update (default: everything):"
    echo "  main      system packages only (dnf)"
    echo "  flatpak   Flatpak apps only"
    echo "  <app>     just that app: the system package if it's installed,"
    echo "            otherwise every Flatpak app whose name or ID contains <app>"
    echo ""
    echo "What to do when done (default: ask):"
    echo "  -r  reboot"
    echo "  -p  power off"
    echo "  -n  do nothing"
}

# Read what to update and what to do afterwards (flags can go before or after it)
target=""
choice=""
for arg in "$@"; do
    case "$arg" in
        -r|-p|-n)
            if [ -n "$choice" ]; then
                echo "Use only one of -r, -p, -n" >&2; usage >&2; exit 1
            fi
            choice=${arg#-}
            ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "Unknown option: $arg" >&2; usage >&2; exit 1 ;;
        *)
            if [ -n "$target" ]; then
                echo "Update one thing at a time (got '$target' and '$arg')" >&2; usage >&2; exit 1
            fi
            target=$arg
            ;;
    esac
done

# Steps that fail are collected here and reported at the end
FAILED=()

# dnf options:
# -y:             answer yes to every prompt
# --allowerasing: remove conflicting packages instead of cancelling the update
# --no-best:      if the newest version of a package can't be installed, skip it instead of cancelling the update
DNF_OPTS=(-y --allowerasing --no-best)

# Update system packages via dnf
update_main() {
    sudo dnf upgrade "${DNF_OPTS[@]}" || FAILED+=("system packages (dnf upgrade)")
}

# Is $1 installed as a system package?
is_installed() {
    rpm -q "$1" >/dev/null 2>&1
}

# Update only the package $1
update_package() {
    sudo dnf upgrade "${DNF_OPTS[@]}" "$1" || FAILED+=("$1 (dnf upgrade $1)")
}

# Update every Flatpak app
update_flatpak() {
    flatpak update -y || FAILED+=("Flatpak apps (flatpak update)")
}

# Installed Flatpak apps whose ID or name contains $1 (ignoring case)
find_flatpaks() {
    command -v flatpak >/dev/null || return
    flatpak list --app --columns=application,name | grep -iF -- "$1" | cut -f1 | sort -u
}

case "$target" in
    "")
        echo "Starting system update..."
        update_main
        if command -v flatpak >/dev/null; then
            update_flatpak
        fi
        ;;
    main)
        echo "Updating system packages..."
        update_main
        ;;
    flatpak)
        if ! command -v flatpak >/dev/null; then
            echo "Flatpak is not installed. Nothing was updated." >&2; exit 1
        fi
        echo "Updating Flatpak apps..."
        update_flatpak
        ;;
    *)
        # System package first (also tries the name in lowercase), then Flatpak
        pkg=""
        if is_installed "$target"; then
            pkg=$target
        elif is_installed "${target,,}"; then
            pkg=${target,,}
        fi
        if [ -n "$pkg" ]; then
            echo "Updating $pkg (system package)..."
            update_package "$pkg"
        else
            readarray -t apps < <(find_flatpaks "$target")
            if [ ${#apps[@]} -eq 0 ]; then
                echo "'$target' is not installed as a system package or a Flatpak app. Nothing was updated." >&2
                exit 1
            fi
            echo "'$target' is not a system package, updating Flatpak app(s): ${apps[*]}"
            flatpak update -y "${apps[@]}" || FAILED+=("Flatpak: ${apps[*]} (flatpak update)")
        fi
        ;;
esac

echo ""
echo "=========================================="
if [ ${#FAILED[@]} -eq 0 ]; then
    echo "All updates completed successfully!"
else
    echo "Some updates FAILED:"
    for step in "${FAILED[@]}"; do
        echo "  - $step"
    done
    echo "Scroll up to see the error messages."
fi
echo "=========================================="
echo ""

# Prompt for post-update action, unless a flag already chose it
if [ -z "$choice" ]; then
    read -p "Choose action: [r]eboot / [p]oweroff / [n]othing (default): " choice
fi

case "$choice" in
    r|reboot)
        echo "Rebooting system..."
        systemctl reboot
        ;;
    p|poweroff)
        echo "Powering off system..."
        systemctl poweroff
        ;;
    *)
        echo "Doing nothing. Have a great day!"
        ;;
esac
